# ───────────────────────────────────────────────
# Core project ignores
# ───────────────────────────────────────────────

# Node modules
node_modules/

# Electron build artifacts
dist/
out/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific junk
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# ───────────────────────────────────────────────
# Ghost OS specific
# ───────────────────────────────────────────────

# Ghost memory files (runtime state)
ghost_memory.json
ghost_memory_backup.json
memory/

# Any future memory snapshots
memory_*.json

# Cached latent states or debug dumps
latent_dump_*.json
debug_*.json

# Webcam or frame captures
frames/
captures/

# Datasets
datasets/

# Temporary scratch files
tmp/
temp/
*.tmp

# ───────────────────────────────────────────────
# C++ build artifacts
# ───────────────────────────────────────────────

native/build/
*.node

# ───────────────────────────────────────────────
# Python
# ───────────────────────────────────────────────

.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ───────────────────────────────────────────────
# VS Code
# ───────────────────────────────────────────────

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json