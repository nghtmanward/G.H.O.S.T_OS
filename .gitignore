# ───────────────────────────────────────────────
# Core project ignores
# ───────────────────────────────────────────────

# Node modules
node_modules/

# Electron build artifacts
dist/
out/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific junk
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# ───────────────────────────────────────────────
# Ghost OS specific
# ───────────────────────────────────────────────

# Ghost memory files (runtime state)
ghost_memory.json
ghost_memory_backup.json

# Any future memory snapshots
memory_*.json

# Cached latent states or debug dumps
latent_dump_*.json
debug_*.json

# Webcam or frame captures (if you ever add them)
frames/
captures/

# Temporary scratch files
tmp/
temp/
*.tmp

# ───────────────────────────────────────────────
# VS Code
# ───────────────────────────────────────────────

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ───────────────────────────────────────────────
# Git
# ───────────────────────────────────────────────

# Ignore everything in .gitignore itself
.gitignore